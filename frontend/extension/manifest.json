{
    "manifest_version": 3,
    "name": "Cognitive Cat",
    "version": "1.0",
    "description": "Floating fatigue-aware cat",
    "permissions": [
        "scripting",
        "activeTab"
    ],
    "host_permissions": [
        "http://localhost:8000/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "sounds/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}